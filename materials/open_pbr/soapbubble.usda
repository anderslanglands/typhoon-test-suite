#usda 1.0
(
    defaultPrim = "standard_shader_ball_scene"
    metersPerUnit = 0.01
    renderSettingsPrimPath = "/Render/RenderSettings"
    subLayers = [
        @../_assets/shaderball/scene.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "soapbubble" (
    )
    {
        token outputs:mtlx:surface.connect = </Looks/soapbubble/open_pbr_surface_surfaceshader.outputs:out>
        token outputs:surface.connect = </Looks/soapbubble/open_pbr_surface_surfaceshader.outputs:out>

        def Shader "open_pbr_surface_surfaceshader"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            bool inputs:geometry_thin_walled = 1
            float inputs:specular_ior = 1
            float inputs:specular_roughness = 0
            float inputs:thin_film_ior = 1.4
            float inputs:thin_film_thickness = 0.5
            float inputs:thin_film_weight = 1
            float inputs:transmission_weight = 1
            token outputs:out
        }
    }
}

over "standard_shader_ball_scene"
{
    over "shader_ball"
    {
        over "material_surface" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Looks/soapbubble>
        }

    }
}

over "Render"
{
    over "RenderSettings"
    {
    }

    over "Product"
    {
        token productName = "open_pbr/soapbubble.exr"
    }
}
