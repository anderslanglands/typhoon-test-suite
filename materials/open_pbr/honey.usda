#usda 1.0
(
    defaultPrim = "standard_shader_ball_scene"
    metersPerUnit = 0.01
    renderSettingsPrimPath = "/Render/RenderSettings"
    subLayers = [
        @../_assets/shaderball/scene.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "honey" (
    )
    {
        token outputs:mtlx:surface.connect = </Looks/honey/open_pbr_surface_surfaceshader.outputs:out>
        token outputs:surface.connect = </Looks/honey/open_pbr_surface_surfaceshader.outputs:out>

        def Shader "open_pbr_surface_surfaceshader"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            float inputs:specular_ior = 1.504
            float inputs:specular_roughness = 0
            color3f inputs:transmission_color = (0.83, 0.4, 0.04)
            float inputs:transmission_depth = 2
            color3f inputs:transmission_scatter = (0.9, 0.9, 0.9)
            float inputs:transmission_weight = 1
            token outputs:out
        }
    }
}

over "standard_shader_ball_scene"
{
    over "shader_ball"
    {
        over "material_surface" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Looks/honey>
        }

    }
}

over "Render"
{
    over "RenderSettings"
    {
        uniform int ty:convergedSamplesPerPixel = 128

    }

    over "Product"
    {
        token productName = "open_pbr/honey.exr"
    }
}
