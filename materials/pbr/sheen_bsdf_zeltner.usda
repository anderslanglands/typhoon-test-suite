#usda 1.0
(
    defaultPrim = "standard_shader_ball_scene"
    metersPerUnit = 0.01
    renderSettingsPrimPath = "/Render/RenderSettings"
    subLayers = [
        @../_assets/shaderball/scene.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "sheen_bsdf_zeltner" (
    )
    {
        token outputs:mtlx:surface.connect = </Looks/sheen_bsdf_zeltner/surface.outputs:out>
        token outputs:surface.connect = </Looks/sheen_bsdf_zeltner/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_sheen_bsdf"
            color3f inputs:color = (0.75, 0.12, 0.55)
            string inputs:mode = "zeltner"
            float inputs:roughness = 0.35
            float inputs:weight = 1
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:bsdf.connect = </Looks/sheen_bsdf_zeltner/node_under_test.outputs:out>
            token outputs:out
        }
    }
}

over "standard_shader_ball_scene"
{
    over "shader_ball"
    {
        over "material_surface" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Looks/sheen_bsdf_zeltner>
        }

    }
}

over "Render"
{
    over "Product"
    {
        token productName = "pbr/sheen_bsdf_zeltner.exr"
    }
}
