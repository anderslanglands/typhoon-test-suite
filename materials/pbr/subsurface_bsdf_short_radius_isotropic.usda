#usda 1.0
(
    defaultPrim = "standard_shader_ball_scene"
    metersPerUnit = 0.01
    renderSettingsPrimPath = "/Render/RenderSettings"
    subLayers = [
        @../_assets/shaderball/scene.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "subsurface_bsdf_short_radius_isotropic" (
    )
    {
        token outputs:mtlx:surface.connect = </Looks/subsurface_bsdf_short_radius_isotropic/surface.outputs:out>
        token outputs:surface.connect = </Looks/subsurface_bsdf_short_radius_isotropic/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_subsurface_bsdf"
            float inputs:anisotropy = 0
            color3f inputs:color = (0.9, 0.32, 0.18)
            color3f inputs:radius = (0.05, 0.05, 0.05)
            float inputs:weight = 1
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:bsdf.connect = </Looks/subsurface_bsdf_short_radius_isotropic/node_under_test.outputs:out>
            token outputs:out
        }
    }
}

over "standard_shader_ball_scene"
{
    over "shader_ball"
    {
        over "material_surface" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Looks/subsurface_bsdf_short_radius_isotropic>
        }

    }
}

over "Render"
{
    over "RenderSettings"
    {
        uniform int ty:convergedSamplesPerPixel = 128
    }

    over "Product"
    {
        token productName = "pbr/subsurface_bsdf_short_radius_isotropic.exr"
    }
}
