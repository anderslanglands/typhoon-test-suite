#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

over "World"
{
    def DomeLight "DomeLight"
    {
        float inputs:intensity = 1
        asset inputs:texture:file = @../materials/Lights/san_giuseppe_bridge_2k.hdr@
        token inputs:texture:format = "latlong"
    }
}
