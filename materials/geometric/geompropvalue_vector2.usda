#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../_assets/plane/base.usda@,
        @../_assets/plane/plane.usda@,
        @../_assets/plane/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "geompropvalue_vector2" (
    )
    {
        token outputs:mtlx:surface.connect = </Looks/geompropvalue_vector2/surface.outputs:out>
        token outputs:surface.connect = </Looks/geompropvalue_vector2/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/geompropvalue_vector2/NG_geompropvalue_vector2.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/geompropvalue_vector2/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_geompropvalue_vector2"
        {
            color3f outputs:out_base_color.connect = </Looks/geompropvalue_vector2/NG_geompropvalue_vector2/to_color.outputs:out>

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_geompropvalue_vector2"
                string inputs:geomprop = "testVector2"
                float2 inputs:default = (0, 0)
                float2 outputs:out
            }

            def Shader "to_color"
            {
                uniform token info:id = "ND_convert_vector2_color3"
                float2 inputs:in.connect = </Looks/geompropvalue_vector2/NG_geompropvalue_vector2/node_under_test.outputs:out>
                color3f outputs:out
            }
        }

    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float2[] primvars:testVector2 = [(0, 0), (0, 1), (1, 1), (1, 0)] (
            interpolation = "vertex"
        )
        rel material:binding = </Looks/geompropvalue_vector2>
    }
}

over "Render"
{
    over "Settings"
    {

        over "Product"
        {
            token productName = "geometric/geompropvalue_vector2.exr"
        }
    }
}
