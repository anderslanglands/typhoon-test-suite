#usda 1.0
(
    defaultPrim = "standard_shader_ball_scene"
    metersPerUnit = 0.01
    renderSettingsPrimPath = "/Render/RenderSettings"
    subLayers = [
        @../_assets/shaderball/scene.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "normal_space_object" (
    )
    {
        token outputs:mtlx:surface.connect = </Looks/normal_space_object/SR_normal_space_object.outputs:out>
        token outputs:surface.connect = </Looks/normal_space_object/SR_normal_space_object.outputs:out>

        def Shader "SR_normal_space_object"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 1
            color3f inputs:base_color.connect = </Looks/normal_space_object/NG_normal_space_object.outputs:out_base_color>
            float inputs:specular = 1
            float inputs:specular_roughness = 0.2
            token outputs:out
        }

        def NodeGraph "NG_normal_space_object"
        {
            color3f outputs:out_base_color.connect = </Looks/normal_space_object/NG_normal_space_object/normal_color.outputs:out>

            def Shader "normal_sample_object"
            {
                uniform token info:id = "ND_image_vector3"
                float3 inputs:default = (0.5, 0.5, 1)
                asset inputs:file = @../_assets/materials/Materials/showcase/standard_surface/brick_procedural/textures/brick_normal.jpg@ (
                    colorSpace = "none"
                )
                float3 outputs:out
            }

            def Shader "normal_object_scale"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/normal_space_object/NG_normal_space_object/normal_sample_object.outputs:out>
                float3 inputs:in2 = (2, 2, 2)
                float3 outputs:out
            }

            def Shader "normal_object_signed"
            {
                uniform token info:id = "ND_subtract_vector3"
                float3 inputs:in1.connect = </Looks/normal_space_object/NG_normal_space_object/normal_object_scale.outputs:out>
                float3 inputs:in2 = (1, 1, 1)
                float3 outputs:out
            }

            def Shader "normal_object_unit"
            {
                uniform token info:id = "ND_normalize_vector3"
                float3 inputs:in.connect = </Looks/normal_space_object/NG_normal_space_object/normal_object_signed.outputs:out>
                float3 outputs:out
            }

            def Shader "normal_object_to_world"
            {
                uniform token info:id = "ND_transformnormal_vector3"
                string inputs:fromspace = "object"
                float3 inputs:in.connect = </Looks/normal_space_object/NG_normal_space_object/normal_object_unit.outputs:out>
                string inputs:tospace = "world"
                float3 outputs:out
            }

            def Shader "normal_half"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/normal_space_object/NG_normal_space_object/normal_object_to_world.outputs:out>
                float3 inputs:in2 = (0.5, 0.5, 0.5)
                float3 outputs:out
            }

            def Shader "normal_01"
            {
                uniform token info:id = "ND_add_vector3"
                float3 inputs:in1.connect = </Looks/normal_space_object/NG_normal_space_object/normal_half.outputs:out>
                float3 inputs:in2 = (0.5, 0.5, 0.5)
                float3 outputs:out
            }

            def Shader "normal_color"
            {
                uniform token info:id = "ND_convert_vector3_color3"
                float3 inputs:in.connect = </Looks/normal_space_object/NG_normal_space_object/normal_01.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "standard_shader_ball_scene"
{
    over "shader_ball"
    {
        over "material_surface" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Looks/normal_space_object>
        }

    }
}

over "Render"
{
    over "Product"
    {
        token productName = "geometric/normal_space_object.exr"
    }
}
