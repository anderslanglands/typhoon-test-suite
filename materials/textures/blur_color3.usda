#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../_assets/plane/base.usda@,
        @../_assets/plane/plane.usda@,
        @../_assets/plane/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "blur_color3" (
    )
    {
        token outputs:mtlx:surface.connect = </Looks/blur_color3/surface.outputs:out>
        token outputs:surface.connect = </Looks/blur_color3/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/blur_color3/NG_blur_color3.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/blur_color3/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_blur_color3"
        {
            color3f outputs:out_base_color.connect = </Looks/blur_color3/NG_blur_color3/node_under_test.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "base_image"
            {
                uniform token info:id = "ND_image_color3"
                color3f inputs:default = (1, 0, 1)
                asset inputs:file = @../_assets/materials/Materials/nodes/image_format_png/textures/texture.png@ (
                    colorSpace = "srgb_rec709_scene"
                )
                float2 inputs:texcoord.connect = </Looks/blur_color3/NG_blur_color3/uv0.outputs:out>
                string inputs:uaddressmode = "periodic"
                string inputs:vaddressmode = "periodic"
                color3f outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_blur_color3"
                string inputs:filtertype = "gaussian"
                color3f inputs:in.connect = </Looks/blur_color3/NG_blur_color3/base_image.outputs:out>
                float inputs:size = 0.12
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/blur_color3>
    }
}

over "Render"
{
    over "Settings"
    {

        over "Product"
        {
            token productName = "textures/blur_color3.exr"
        }
    }
}
