#usda 1.0
(
    defaultPrim = "standard_shader_ball_scene"
    metersPerUnit = 0.01
    renderSettingsPrimPath = "/Render/RenderSettings"
    subLayers = [
        @../_assets/shaderball/scene.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "feature_sheen" (
    )
    {
        token outputs:mtlx:surface.connect = </Looks/feature_sheen/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/feature_sheen/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.55, 0.9, 0.35)
            float inputs:sheen = 1
            token outputs:out
        }
    }
}

over "standard_shader_ball_scene"
{
    over "shader_ball"
    {
        over "material_surface" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Looks/feature_sheen>
        }

    }
}

over "Render"
{
    over "Product"
    {
        token productName = "standard_surface/feature_sheen.exr"
    }
}
