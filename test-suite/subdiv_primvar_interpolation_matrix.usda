#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    renderSettingsPrimPath = "/RenderSettings"
    doc = """Subdivision primvar interpolation matrix.
    Columns: uniform, vertex, varying, faceVarying.
    Rows: faceVaryingLinearInterpolation none, cornersOnly, cornersPlus1,
          cornersPlus2, boundaries, all.
    The indexed face-varying column contains shared regions, seams, corners,
    and darts; the other columns are controls that must not change by row.
    """
)

