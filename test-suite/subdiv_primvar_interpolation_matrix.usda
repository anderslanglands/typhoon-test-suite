def RenderSettings "RenderSettings" (
    prepend apiSchemas = ["TyphoonRenderSettingsAPI"]
)
{
    rel camera = </Camera>
    rel products = [</RenderProduct>]
    float pixelAspectRatio = 1
    int2 resolution = (170, 256)
    token ty:samplerSequence = "openqmc_sobolbn"
    int ty:convergedSamplesPerPixel = 1
    int ty:randomNumberSeed = 1
    int ty:maxBounces = 0
}

def RenderProduct "RenderProduct"
{
    rel camera = </Camera>
    rel orderedVars = [</RenderProduct/Color>]
    token productName = "subdiv_primvar_interpolation_matrix.exr"
    token productType = "raster"

    def RenderVar "Color"
    {
        token dataType = "color4f"
        string sourceName = "color"
        token sourceType = "raw"
    }
}

def Camera "Camera"
{
    float focalLength = 35
    float horizontalAperture = 20
    float verticalAperture = 30
    float2 clippingRange = (0.1, 1000)
    double3 xformOp:translate = (0, 0, 20)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Xform "World"
{
    def Scope "Materials"
    {
        def Material "PrimvarColor"
        {
            token outputs:mtlx:surface.connect = </World/Materials/PrimvarColor/Surface.outputs:out>

            def Shader "ReadColor"
            {
                uniform token info:id = "ND_geompropvalue_color3"
                string inputs:geomprop = "testColor"
                color3f inputs:default = (1, 0, 1)
                color3f outputs:out
            }

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 0
                float inputs:specular = 0
                float inputs:emission = 1
                color3f inputs:emission_color.connect = </World/Materials/PrimvarColor/ReadColor.outputs:out>
                token outputs:out
            }
        }
    }

    def Mesh "none_uniform" (
        references = </UniformProto>
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token faceVaryingLinearInterpolation = "none"
        rel material:binding = </World/Materials/PrimvarColor>
        double3 xformOp:translate = (-3.6, 5, 0)
        float3 xformOp:scale = (0.82, 0.82, 0.82)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Mesh "none_vertex" (
        references = </VertexProto>
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token faceVaryingLinearInterpolation = "none"
        rel material:binding = </World/Materials/PrimvarColor>
        double3 xformOp:translate = (-1.2, 5, 0)
        float3 xformOp:scale = (0.82, 0.82, 0.82)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Mesh "none_varying" (
        references = </VaryingProto>
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token faceVaryingLinearInterpolation = "none"
        rel material:binding = </World/Materials/PrimvarColor>
        double3 xformOp:translate = (1.2, 5, 0)
