#usda 1.0
(
    defaultPrim = "World"
    renderSettingsPrimPath = "/RenderSettings"
    subLayers = [
        @./_assets/scenes/cornell_box.usda@
    ]
)

def RenderSettings "RenderSettings" (
    prepend apiSchemas = ["TyphoonRenderSettingsAPI"]
)
{
    rel camera = </Camera>
    rel products = [</RenderProduct>]
    float pixelAspectRatio = 1
    int2 resolution = (256, 170)
}

def RenderProduct "RenderProduct"
{
    rel camera = </Camera>
    rel orderedVars = [</RenderProduct/Color>]
    token productName = "cornell_box.exr"
    token productType = "raster"

    def RenderVar "Color"
    {
        token dataType = "color4f"
        string sourceName = "color"
        token sourceType = "raw"
    }
}
